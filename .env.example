# Copy this file to ".env" and fill in your own values.
# Never commit your real .env file to GitHub or share it with anyone.

# Your Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Which Claude model to use (optional - this default is fine for the capstone)
ANTHROPIC_MODEL=claude-sonnet-5

# Which port to run the server on (optional)
PORT=3000
